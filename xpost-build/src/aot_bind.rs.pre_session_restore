//! Emit `aot_map_bind.rs`: AOT `&map` VMAs from `bpf.toml` `aot_addr` → name table.

use std::collections::BTreeMap;
use std::fs;
use std::path::Path;

use anyhow::{Context, Result};

use crate::util::{escape_rust_str, parse_addr_list, parse_optional_addr};

pub struct AotBindGen {
    pub warnings: Vec<String>,
}

pub fn generate(manifest_dir: &Path, out_dir: &Path) -> Result<AotBindGen> {
    let mut warnings = Vec::new();
    let out_path = out_dir.join("aot_map_bind.rs");
    let bpf_toml_path = manifest_dir.join("bpf.toml");

    let text = fs::read_to_string(&bpf_toml_path)
        .with_context(|| format!("failed to read {}", bpf_toml_path.display()))?;
    let root: toml::Table = text.parse().with_context(|| "failed to parse bpf.toml")?;

    let mut binds: Vec<(String, usize)> = Vec::new();
    let mut user_names: BTreeMap<String, ()> = BTreeMap::new();
    if let Some(maps) = root.get("maps").and_then(|v| v.as_table()) {
        let maps: BTreeMap<&String, &toml::Value> = maps.iter().collect();
        for (name, entry) in maps {
            let table = entry
                .as_table()
                .ok_or_else(|| anyhow::anyhow!("[maps.{name}] must be a table"))?;
            let Some(addr) = parse_optional_addr(table, "aot_addr", name) else {
                warnings.push(format!(
                    "bpf.toml [maps.{name}] missing aot_addr — AOT helpers will not resolve &{name}"
                ));
                continue;
            };
            if addr == 0 {
                warnings.push(format!("bpf.toml [maps.{name}] aot_addr is 0 — skipped"));
                continue;
            }
            user_names.insert(name.clone(), ());
            binds.push((name.clone(), addr));
            for alias in parse_addr_list(table, "aot_aliases", name) {
                if alias == 0 || alias == addr {
                    continue;
                }
                binds.push((name.clone(), alias));
            }
        }
    }

    let mut out = String::from(
        "// @generated by xtask from bpf.toml aot_addr — do not edit\n\
         /// Bind absolute `.maps` addresses from the loaded AOT image to registered map names.\n\
         /// Prefer [`XdpRt::lease`], which builds the VMR table from [`AOT_MAP_BINDS`].\n\
         pub fn bind_aot_map_addrs() {\n",
    );

    if !binds.is_empty() {
        out.push_str("    use crate::map::bind_map_symbols;\n");
        out.push_str("    bind_map_symbols(&[\n");
        for (name, addr) in &binds {
            out.push_str(&format!(
                "        (\"{}\", 0x{addr:x}),\n",
                escape_rust_str(name)
            ));
        }
        out.push_str("    ]);\n");
    }
    out.push_str("}\n");
    out.push_str(&format!(
        "/// Number of AOT map aliases bound from bpf.toml `aot_addr` (+ `aot_aliases`).\n\
         pub const AOT_MAP_BIND_COUNT: usize = {};\n",
        binds.len()
    ));
    out.push_str(
        "/// `(map_name, vma)` pairs for [`crate::xdp::XdpRt::lease`] VMR→RMA install.\n\
         pub const AOT_MAP_BINDS: &[(&str, usize)] = &[\n",
    );
    for (name, addr) in &binds {
        out.push_str(&format!(
            "    (\"{}\", 0x{addr:x}),\n",
            escape_rust_str(name)
        ));
    }
    out.push_str("];\n");
    out.push_str(
        "/// Map names referenced by the boot AOT image (`RawResource::users`).\n\
         pub const AOT_MAP_USER_NAMES: &[&str] = &[\n",
    );
    for name in user_names.keys() {
        out.push_str(&format!("    \"{}\",\n", escape_rust_str(name)));
    }
    out.push_str("];\n");

    fs::write(&out_path, out).with_context(|| format!("write {}", out_path.display()))?;

    Ok(AotBindGen { warnings })
}
