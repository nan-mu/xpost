//! Compact ELF fixed layouts + metadata SRAM reader
//! (`libbpf-mcu/docs/xpost_compact_elf.proto`).
//!
//! - [`flash_layout!`](xpost_macros::flash_layout): fixed offset SRAM getters
//! - [`FlashBuffer`] / [`XpostMeta`]: one bulk read into `heapless::Vec`
//! - [`MetaCursor`]: variable-length parse (no Flash I/O)

mod buffer;
mod cursor;
mod meta;
mod readers;

pub(crate) use buffer::FlashBuffer;
pub(crate) use meta::{XpostMeta, MAX_META_SIZE};
pub(crate) use readers::{Elf32Header, ElfDigest, ElfSectionHeader, XpostMetaPrefix};

/// Construction / parse errors for layout + bulk readers.
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub(crate) enum ReadError {
    AddressOverflow,
    OutOfBounds,
    Storage,
    Truncated,
    MetadataTooLarge,
}

/// Alias used by generated `flash_layout!` `parse`.
pub(crate) type LayoutError = ReadError; 

/// Streaming read for image SHA only (not metadata getters).
#[inline]
pub(crate) fn visit_table_bytes(
    table: &mut dyn crate::xdp::XdpTableStorage,
    base: usize,
    len: usize,
    mut visit: impl FnMut(&[u8]),
) -> Result<(), ReadError> {
    #[repr(C, align(4))]
    struct Block([u8; 68]);

    #[inline(always)]
    const fn align_down4(x: usize) -> usize {
        x & !3
    }
    #[inline(always)]
    const fn align_up4(x: usize) -> usize {
        (x + 3) & !3
    }

    if len == 0 {
        return Ok(());
    }
    let end = base.checked_add(len).ok_or(ReadError::AddressOverflow)?;
    let physical_end = align_up4(end);
    if physical_end > table.capacity() {
        return Err(ReadError::OutOfBounds);
    }

    let mut block = Block([0; 68]);
    let mut current = base;
    while current < end {
        let n = (end - current).min(64);
        let prefix = current & 3;
        let physical_start = align_down4(current);
        let physical_len = align_up4(prefix + n);
        if physical_start.saturating_add(physical_len) > table.capacity() {
            return Err(ReadError::OutOfBounds);
        }
        table
            .read(physical_start, &mut block.0[..physical_len])
            .map_err(|_| ReadError::Storage)?;
        visit(&block.0[prefix..prefix + n]);
        current += n;
    }
    Ok(())
}
