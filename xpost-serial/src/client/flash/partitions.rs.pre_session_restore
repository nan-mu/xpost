//! Board `partitions.csv` → binary table for espflash.
//!
//! Cold XDP storage uses an application-defined partition **type** in the
//! ESP-IDF reserved range `0x40..=0xFE` (not `data` + numeric subtype).
//! That form is accepted by [`PartitionTable::try_from_str`].

use std::fs;
use std::path::Path;

use esp_idf_part::PartitionTable;

use crate::client::error::{Error, Result};

/// Default ESP-IDF partition-table flash offset (ESP32-C3).
pub(crate) const PART_TABLE_OFFSET: u32 = 0x8000;

/// Parse board `partitions.csv` into a binary partition table.
pub(crate) fn partition_table_bin(path: &Path) -> Result<Vec<u8>> {
    let text = fs::read_to_string(path).map_err(|e| {
        Error::Msg(format!("read partition table {}: {e}", path.display()))
    })?;
    let table = PartitionTable::try_from_str(text).map_err(|e| {
        Error::Msg(format!("partition table {}: {e}", path.display()))
    })?;
    table
        .to_bin()
        .map_err(|e| Error::Msg(format!("partition to_bin: {e}")))
}
