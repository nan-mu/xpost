/// Default partition label for the XDP flash span (`partitions.csv` Name column).
pub const DEFAULT_XDP_PARTITION: &str = "xdp";

/// Flash-side ends of the bridge created in [`crate::client::Client::open`].
///
/// `tx` → serial worker (`Begin` / `End` / `Failed`); `ack` ← serial after it
/// applied release/resume. One ack channel for the whole task (not per notify).
pub struct SerialNotify {
    pub(crate) tx: mpsc::UnboundedSender<Flash>,
    pub(crate) ack: Mutex<std::sync::mpsc::Receiver<()>>,
}

impl SerialNotify {
    fn send_wait(&self, ev: Flash) {
        if self.tx.send(ev).is_err() {
            return;
        }
        let ack = self.ack.lock().unwrap_or_else(|e| e.into_inner());
        let _ = ack.recv_timeout(FLASH_ACK_TIMEOUT);
    }
}

enum FlashReq {
    Op {
        op: FlashOp,
        resp: oneshot::Sender<Result<FlashResult>>,
    },
    Shutdown,
}

/// Outcome of a flash-task operation.
#[derive(Clone, Debug)]
pub enum FlashResult {
    Done,
    Install(InstallOutcome),
    List(Vec<XdpEntry>),
}

/// Handle for flash operations (dedicated tokio task; exclusive with App UART).
pub struct FlashHandle {
    tx: mpsc::UnboundedSender<FlashReq>,
    join: Option<tokio::task::JoinHandle<()>>,
}

impl FlashHandle {
    pub async fn flash_fw(&self, firmware: &Path, partitions: &Path) -> Result<()> {
        match self
            .call(FlashOp::Fw {
                firmware: firmware.display().to_string(),
                partitions: partitions.display().to_string(),
            })
            .await?
        {
            FlashResult::Done => Ok(()),
            other => Err(Error::Msg(format!("unexpected flash result: {other:?}"))),
        }
    }

    pub async fn flash_xdp(&self, name: &str, path: &Path) -> Result<InstallOutcome> {
        match self
            .call(FlashOp::Xdp {
                name: name.to_string(),
                path: path.display().to_string(),
            })
            .await?
        {
            FlashResult::Install(o) => Ok(o),
            other => Err(Error::Msg(format!("unexpected flash result: {other:?}"))),
        }
    }

    /// `names` empty ⇒ clear entire XDP table (`*`).
    pub async fn clear_xdp(&self, names: &[String]) -> Result<()> {
        match self
            .call(FlashOp::Clear {
                names: names.to_vec(),
            })
            .await?
        {
            FlashResult::Done => Ok(()),
            other => Err(Error::Msg(format!("unexpected flash result: {other:?}"))),
        }
    }

    pub async fn list_xdp(&self) -> Result<Vec<XdpEntry>> {
        match self.call(FlashOp::List).await? {
            FlashResult::List(v) => Ok(v),
            other => Err(Error::Msg(format!("unexpected flash result: {other:?}"))),
        }
    }

    async fn call(&self, op: FlashOp) -> Result<FlashResult> {
        let (resp_tx, resp_rx) = oneshot::channel();
        self.tx
            .send(FlashReq::Op { op, resp: resp_tx })
            .map_err(|_| Error::Msg("flash task closed".into()))?;
        resp_rx
            .await
            .map_err(|_| Error::Msg("flash response dropped".into()))?
    }

    pub async fn shutdown(mut self) {
        let _ = self.tx.send(FlashReq::Shutdown);
        if let Some(j) = self.join.take() {
            let _ = j.await;
        }
    }
}

impl Drop for FlashHandle {
    fn drop(&mut self) {
        let _ = self.tx.send(FlashReq::Shutdown);
        if let Some(j) = self.join.take() {
            j.abort();
        }
    }
}

/// Flash worker config. XDP span is always resolved from [`Self::partitions`].
#[derive(Clone)]
pub struct FlashConfig {
    pub port: Option<PathBuf>,
    pub chip: Chip,
    /// Board `partitions.csv` (source of truth for the XDP flash span).
    pub partitions: PathBuf,
    /// Partition Name column (default [`DEFAULT_XDP_PARTITION`]).
    pub partition_name: String,
    /// Host cap on a single XDP ELF (also min'd with CSV-derived capacity).
    pub image_capacity: usize,
}

impl FlashConfig {
    /// Build config from a board `partitions.csv` (partition label `"xdp"`).
    pub fn from_partitions_csv(partitions: impl Into<PathBuf>) -> Result<Self> {
        Self::from_partitions_csv_named(partitions, DEFAULT_XDP_PARTITION)
    }

    /// Build config from `partitions.csv` + partition label.
    pub fn from_partitions_csv_named(
        partitions: impl Into<PathBuf>,
        partition_name: impl Into<String>,
    ) -> Result<Self> {
        let partitions = partitions.into();
        let partition_name = partition_name.into();
        let table = xdp_table_from_csv(&partitions, &partition_name)?;
        Ok(Self {
            port: None,
            chip: Chip::Esp32c3, // TODO: To be configurable in the distant future
            partitions,
            partition_name,
            image_capacity: table.image_capacity,
        })
    }

    /// Resolve [`XdpTable`] from [`Self::partitions`] / [`Self::partition`].
    pub fn xdp_table(&self) -> Result<XdpTable> {
        let mut table = xdp_table_from_csv(&self.partitions, &self.partition_name)?;
        table.image_capacity = table.image_capacity.min(self.image_capacity);
        Ok(table)
    }
}

/// Spawn flash worker. `notify` ends come from [`crate::client::Client::open`].
pub fn spawn(cfg: FlashConfig, notify: Arc<SerialNotify>) -> FlashHandle {
    let (tx, rx) = mpsc::unbounded_channel();
    let join = tokio::spawn(worker(cfg, rx, notify));
    FlashHandle {
        tx,
        join: Some(join),
    }
}

async fn worker(
    cfg: FlashConfig,
    mut rx: mpsc::UnboundedReceiver<FlashReq>,
    notify: Arc<SerialNotify>,
) {
    while let Some(req) = rx.recv().await {
        match req {
            FlashReq::Shutdown => break,
            FlashReq::Op { op, resp } => {
                let cfg = cfg.clone();
                let notify = Arc::clone(&notify);
                let result = tokio::task::spawn_blocking(move || run_op(&cfg, &op, &notify))
                    .map(|join| {
                        join.unwrap_or_else(|e| Err(Error::Msg(format!("flash join: {e}"))))
                    })
                    .await;
                let _ = resp.send(result);
            }
        }
    }
}

fn run_op(cfg: &FlashConfig, op: &FlashOp, notify: &SerialNotify) -> Result<FlashResult> {
    notify.send_wait(Flash::Begin(op.clone()));
    let result = match op {
        FlashOp::Fw {
            firmware,
            partitions,
        } => fw::flash_fw(cfg, Path::new(firmware), Path::new(partitions)).map(|_| FlashResult::Done),
        FlashOp::Xdp { name, path } => {
            xdp::install(cfg, name, Path::new(path)).map(FlashResult::Install)
        }
        FlashOp::Clear { names } => xdp::clear(cfg, names).map(|_| FlashResult::Done),
        FlashOp::List => xdp::list(cfg).map(FlashResult::List),
    };
    match &result {
        Ok(_) => notify.send_wait(Flash::End(op.clone())),
        Err(e) => notify.send_wait(Flash::Failed {
            op: op.clone(),
            msg: e.to_string(),
        }),
    }
    result
}
