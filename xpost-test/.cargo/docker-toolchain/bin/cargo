#!/usr/bin/env bash
# Path-toolchain shims under .cargo/docker-toolchain/bin/{cargo,rustc,…}.
# Mac: rust-toolchain.toml → these binaries → docker exec quirky_villani.
# In-container: fall through to nightly toolchain bins (no rustup / path recurse).
#
# The project is the nearest directory named xpost-test, with a Cargo.toml,
# walking up from the physical cwd. This file's checkout is not the project
# unless that checkout is the one whose cwd invoked it.
#
# XPOST_HOST_ROOT, when set, must exist, and the physical cwd must sit inside
# its physical path (/Users/nan/bs → /Volumes/SSD/bs).
#
# OrbStack virtiofs on /Volumes is unreliable for cargo (config load / metadata
# hang, EINTR on reads). Stage on internal disk, one directory per checkout:
#   ${XPOST_TEST_DOCKER_STAGE:-/Users/nan/.cache/xpost-test-docker}/<hash>
# then mirror target/ back into the discovered project.
set -euo pipefail

CONTAINER="${XPOST_TEST_DOCKER:-quirky_villani}"
TOOL="$(basename "$0")"
NIGHTLY_BIN="/usr/local/rustup/toolchains/nightly-aarch64-unknown-linux-gnu/bin"
REAL="${NIGHTLY_BIN}/${TOOL}"
STAGE_PARENT="${XPOST_TEST_DOCKER_STAGE:-/Users/nan/.cache/xpost-test-docker}"

in_docker() {
  [ -f /.dockerenv ] || [ -n "${XPOST_TEST_IN_DOCKER:-}" ]
}

# Physical path of $1. Components that do not exist yet stay literal.
physical_path() {
  local path="$1"
  local suffix=""
  local existing="$path"
  while [ ! -d "$existing" ]; do
    local base parent
    base="$(basename "$existing")"
    parent="$(dirname "$existing")"
    if [ "$parent" = "$existing" ]; then
      printf '%s\n' "$path"
      return 0
    fi
    suffix="/${base}${suffix}"
    existing="$parent"
  done
  local phys
  phys="$(cd "$existing" && pwd -P)"
  printf '%s%s\n' "$phys" "$suffix"
}

# Nearest xpost-test with Cargo.toml, walking up from the physical cwd.
discover_project() {
  local dir="$1"
  while true; do
    if [ "$(basename "$dir")" = "xpost-test" ] && [ -f "$dir/Cargo.toml" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    local parent
    parent="$(dirname "$dir")"
    if [ "$parent" = "$dir" ]; then
      return 1
    fi
    dir="$parent"
  done
}

if in_docker; then
  if [ ! -x "$REAL" ]; then
    echo "xpost-test docker-toolchain: missing $REAL" >&2
    exit 127
  fi
  exec env -u RUSTUP_HOME RUSTUP_TOOLCHAIN=nightly "$REAL" "$@"
fi

cwd="$(pwd -P)"
project="$(discover_project "$cwd" || true)"

if [ -z "$project" ] || [ ! -d "$project" ]; then
  echo "xpost-test docker-toolchain: no xpost-test project with Cargo.toml above $cwd" >&2
  exit 1
fi

case "$cwd" in
  "$project" | "$project"/*) ;;
  *)
    echo "xpost-test docker-toolchain: cwd $cwd is outside project $project" >&2
    exit 1
    ;;
esac

if [ "$(basename "$project")" != "xpost-test" ] || [ ! -f "$project/Cargo.toml" ]; then
  echo "xpost-test docker-toolchain: expected an xpost-test directory with Cargo.toml, got $project" >&2
  exit 1
fi

if [ -n "${XPOST_HOST_ROOT:-}" ]; then
  if [ ! -d "$XPOST_HOST_ROOT" ]; then
    echo "xpost-test docker-toolchain: HOST_ROOT $XPOST_HOST_ROOT missing" >&2
    exit 1
  fi
  host_real="$(cd "$XPOST_HOST_ROOT" && pwd -P)"
  case "$cwd" in
    "$host_real" | "$host_real"/*) ;;
    *)
      echo "xpost-test docker-toolchain: cwd $cwd is outside $XPOST_HOST_ROOT (→ $host_real)" >&2
      exit 1
      ;;
  esac
fi

case "$STAGE_PARENT" in
  /*) ;;
  *) STAGE_PARENT="${cwd}/${STAGE_PARENT}" ;;
esac
if [ "$STAGE_PARENT" != "/" ]; then
  STAGE_PARENT="${STAGE_PARENT%/}"
fi

project_hash="$(printf '%s' "$project" | shasum -a 256 | awk '{print $1}')"
STAGE_PROJECT="${STAGE_PARENT}/${project_hash}"
stage_phys="$(physical_path "$STAGE_PROJECT")"
case "$stage_phys" in
  /Volumes | /Volumes/*)
    echo "xpost-test docker-toolchain: stage $stage_phys is under /Volumes; keep the stage on internal storage" >&2
    exit 1
    ;;
esac

if [ "${XPOST_TEST_DOCKER_RESOLVE:-}" = "1" ]; then
  printf 'project=%s\n' "$project"
  printf 'stage=%s\n' "$STAGE_PROJECT"
  exit 0
fi

if ! docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true; then
  echo "xpost-test docker-toolchain: container $CONTAINER is not running" >&2
  exit 1
fi

REL="${cwd#"$project"}"
REL="${REL#/}"
STAGE_WD="$STAGE_PROJECT"
if [ -n "$REL" ]; then
  STAGE_WD="$STAGE_PROJECT/$REL"
fi

mkdir -p "$STAGE_PROJECT"
# Refresh staged sources (keep staged target/ for incremental builds).
rsync -a --delete \
  --exclude target \
  --exclude .cargo/docker-toolchain \
  --exclude rust-toolchain.toml \
  "$project"/ "$STAGE_PROJECT"/

# Drop path-toolchain file if rsync brought a copy; use nightly bin directly.
rm -f "$STAGE_PROJECT/rust-toolchain.toml"
mkdir -p "$STAGE_PROJECT/.cargo"
# Local-disk config (avoid virtiofs .cargo/config.toml hang on /Volumes).
cat >"$STAGE_PROJECT/.cargo/config.toml" <<'EOF'
[build]
target-dir = "target"
target = "aarch64-unknown-linux-musl"

[target.aarch64-unknown-linux-musl]
linker = "aarch64-linux-musl-gcc"
EOF

cmd=(docker exec)
if [ -t 0 ] && [ -t 1 ]; then
  cmd+=(-it)
elif [ -t 0 ]; then
  cmd+=(-i)
fi
# Nightly bins first so rustc/cargo are not rustup proxies; keep cargo bin for bpf-linker.
DOCKER_PATH="${NIGHTLY_BIN}:/usr/lib/llvm-18/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
cmd+=(
  -e "XPOST_MEDIUM_REVISION=${XPOST_MEDIUM_REVISION:-}"
  -e XPOST_TEST_IN_DOCKER=1
  -e "PATH=${DOCKER_PATH}"
  -w "$STAGE_WD"
  "$CONTAINER"
  env
  -u
  RUSTUP_HOME
  -u
  RUSTUP_TOOLCHAIN
  "$REAL"
)

set +e
"${cmd[@]}" "$@"
status=$?
set -e

# Mirror build outputs back for scp / local consumers. No --delete.
if [ -d "$STAGE_PROJECT/target" ]; then
  mkdir -p "$project/target"
  rsync -a "$STAGE_PROJECT/target"/ "$project/target"/
fi

exit "$status"
