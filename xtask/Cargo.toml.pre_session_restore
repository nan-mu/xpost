[package]
name = "xtask"
version = "0.1.0"
edition = "2024"
publish = false
description = "xpost workspace dispatcher: cargo xtask <example> <cmd>"

# Independent host workspace (parent defaults to RV32).
[workspace]

[[bin]]
name = "xtask"
path = "src/main.rs"

[dependencies]
anyhow = "1"
clap = { version = "4.5", features = ["derive"] }
xpost-build = { path = "../xpost-build" }
